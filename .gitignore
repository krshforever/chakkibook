# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# node_modules & dist
node_modules/
dist/
.vite/

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS / Editor
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/
.idea/
.firebase/
*service-account*.json


# Secrets — the Gemini API key must never be committed (it is bundled into the
# APK otherwise). Read only as a last resort by server.js.
.gemini-key
.gemini-key.*

# Self-signed TLS certs for LAN HTTPS testing (per-machine, per-IP).
.certs/

# Local test build output
dist-test/

# Generated by `npx cap add android` on the build machine. The APK is built by
# CI; shipping a generated native project in the repo just causes merge pain.
/android/

# Agent tooling — installed third-party skills and local agent scratch notes.
# Regenerable via the firebase agent-skills installer; not application code, so
# it does not belong in the repo history.
.agents/
skills-lock.json
.brain/
